<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.theangel099</groupId>
    <artifactId>habilidadesbedwars</artifactId>
    <version>1.2.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HabilidadesBedwars</name>
    <description>Addon de Habilidades Modernas para Marcely's Bedwars</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Paper Repository for core Spigot/Paper classes -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Marcely's Bedwars Repository -->
        <repository>
            <id>marcely-repo</id>
            <url>https://repo.marcely.de/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- PaperMC API (Usamos 1.21.1 estándar para proveer las clases base de Bukkit/Spigot) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Marcely's Bedwars Core API -->
        <dependency>
            <groupId>de.marcely.bedwars</groupId>
            <artifactId>MBedwars-API</artifactId>
            <version>5.5.8</version>
            <scope>system</scope>
            <systemPath>c:/Users/AlexRaton/Desktop/HOST BEDWARS/plugins/MBedwars-5.5.8.jar</systemPath>
        </dependency>

        <!-- BedwarsCosmetics API -->
        <dependency>
            <groupId>com.alexraton</groupId>
            <artifactId>BedwarsCosmetics</artifactId>
            <version>1.0.3</version>
            <scope>system</scope>
            <systemPath>c:/Users/AlexRaton/Desktop/HOST BEDWARS/plugins/BedwarsCosmetics.jar</systemPath>
        </dependency>

        <!-- Lombok para reducir boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Maven Compiler Plugin configurado para Java 25 LTS -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Plugin para copiar automáticamente el jar al servidor -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Bukkit/Paper soporta la carpeta 'update' para reemplazar plugins al reiniciar -->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="C:/Users/AlexRaton/Desktop/HOST BEDWARS/plugins/update"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

